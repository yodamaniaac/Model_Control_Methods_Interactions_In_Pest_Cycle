Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleReduit", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "0.5"}], ",", 
          RowBox[{"\[Delta]a", "->", "0.6"}], ",", 
          RowBox[{"\[Alpha]l", "->", "0.001"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"L", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], "==", "HeqIni"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]l", "->", "0.001"}], ",", 
          RowBox[{"\[Tau]l", "->", "\[Tau]lN"}], ",", 
          RowBox[{"\[Delta]l", "->", "\[Delta]lN"}]}], "}"}]}]}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"L", ",", "A", ",", "H"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "[", "t", "]"}], ",", 
