    RowBox[{"{", 
     RowBox[{"x", "->", "10"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrepaEqCaraImEq1", " ", "=", 
   RowBox[{"eqCaraImEq1", "/.", 
