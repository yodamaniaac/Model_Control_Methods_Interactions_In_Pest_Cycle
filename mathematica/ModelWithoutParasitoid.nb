    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<Temps en semaines \>\"", "}"}], ",", 
      RowBox[{"{", "\"\<Nb Individus\>\"", "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
