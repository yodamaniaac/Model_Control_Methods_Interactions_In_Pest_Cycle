Cell[CellGroupData[{

Cell["\<\
Tentative de repr\[EAcute]sentation de la manipulation de l\[CloseCurlyQuote]\
\[EAcute]quation caract\[EAcute]ristique pour \[Delta]a et q\
\>", "Subsection",
 CellChangeTimes->{{3.938754418166074*^9, 3.9387544704233313`*^9}, {
  3.938755400093503*^9, 3.938755402542221*^9}, {3.9387558833852*^9, 
  3.938755884665856*^9}},ExpressionUUID->"385e3dd5-8c03-492e-a9af-\
b05b618496b7"],

Cell[CellGroupData[{

Cell["Pour la partit r\[EAcute]elle", "Subsubsection",
 CellChangeTimes->{{3.938754956531*^9, 3.9387549732836*^9}, {
  3.938757542618436*^9, 
  3.938757544467856*^9}},ExpressionUUID->"6d3109fb-1b74-413e-8417-\
6a3a401fb55a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqCaraReEq1", "=", 
   RowBox[{"eqCaraReEq", "/.", 
    RowBox[{"{", 
     RowBox[{"x", "->", "0.1"}], "}"}]}]}], ";", 
  RowBox[{"eqCaraReEq2", "=", 
   RowBox[{"eqCaraReEq", "/.", 
    RowBox[{"{", 
     RowBox[{"x", "->", "1"}], "}"}]}]}], ";", 
  RowBox[{"eqCaraReEq3", "=", 
   RowBox[{"eqCaraReEq", "/.", 
    RowBox[{"{", 
     RowBox[{"x", "->", "10"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrepaEqCaraReEq1", " ", "=", 
   RowBox[{"eqCaraReEq1", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Delta]a", "->", "y"}], ",", 
      RowBox[{"q", "->", "x"}]}], "}"}]}]}], ";", 
  RowBox[{"PrepaEqCaraReEq2", " ", "=", 
   RowBox[{"eqCaraReEq2", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Delta]a", "->", "y"}], ",", 
      RowBox[{"q", "->", "x"}]}], "}"}]}]}], ";", 
  RowBox[{"PrepaEqCaraReEq3", " ", "=", 
   RowBox[{"eqCaraReEq3", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Delta]a", "->", "y"}], ",", 
      RowBox[{"q", "->", "x"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", "PrepaEqCaraReEq1"}], ";", 
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", "PrepaEqCaraReEq2"}], ";", 
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", "PrepaEqCaraReEq3"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
