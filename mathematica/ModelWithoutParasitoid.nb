       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"L", ",", "A", ",", "H"}], "}"}], ",", 
     RowBox[{"{", 
