Cell[BoxData[{
 RowBox[{
  RowBox[{"eqCaraImEq1", "=", 
   RowBox[{"eqCaraImEq", "/.", 
    RowBox[{"{", 
     RowBox[{"x", "->", "0.1"}], "}"}]}]}], ";", 
  RowBox[{"eqCaraImEq2", "=", 
