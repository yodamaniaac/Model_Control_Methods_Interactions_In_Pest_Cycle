Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleReduit", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "20"}], ",", 
          RowBox[{"\[Delta]a", "->", "1"}], ",", 
          RowBox[{"\[Alpha]l", "->", "0.001"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"L", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], "==", "HpIniEq"}], "/.", 
        RowBox[{"{", 
         RowBox[{"q", "->", "40"}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"L", ",", "A", ",", "H"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "[", "t", "]"}], ",", 
       RowBox[{"A", "[", "t", "]"}]}], "}"}], "/.", " ", "solN"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"tmax", "-", "1000"}], ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<L\>\"", ",", "\"\<A\>\""}], "}"}]}], ",", " ", 
