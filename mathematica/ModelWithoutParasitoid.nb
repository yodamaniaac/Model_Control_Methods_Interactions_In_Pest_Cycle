       RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"x", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
