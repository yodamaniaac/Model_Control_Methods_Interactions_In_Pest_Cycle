Cell[CellGroupData[{

Cell["Linearization in the vicinity of a non-trivial fixed point", \
"Subsection",
 CellChangeTimes->{{3.9381538896796837`*^9, 3.938153891487625*^9}, {
   3.972470064157009*^9, 3.972470064237248*^9}, 
   3.9848207482125387`*^9},ExpressionUUID->"de4a373c-9857-4dbd-85ed-\
2d7b21700e5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LinearModel", " ", "=", " ", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"nL", "'"}], "[", "t", "]"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"q", " ", 
       RowBox[{"nA", "[", 
        RowBox[{"t", "-", "\[Tau]u"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]u"}], " ", "du"}], "]"}]}], " ", "-", 
      RowBox[{"a", " ", 
       RowBox[{"nL", "[", "t", "]"}], "Peq"}], "-", 
      RowBox[{"a", " ", "Leq", " ", 
       RowBox[{"nP", "[", "t", "]"}]}], "-", 
      RowBox[{"dl", " ", 
       RowBox[{"nL", "[", "t", "]"}]}], " ", "-", " ", 
      RowBox[{"q", " ", 
       RowBox[{"nA", "[", 
        RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]u"}], " ", "du"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]l"}], " ", "dl"}], "]"}], " ", "Heq"}], "-", " ", 
      RowBox[{"q", " ", "Aeq", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]u"}], " ", "du"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]l"}], " ", "dl"}], "]"}], " ", 
       RowBox[{"nH", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"nA", "'"}], "[", "t", "]"}], " ", "==", "  ", 
     RowBox[{
      RowBox[{"q", " ", 
       RowBox[{"nA", "[", 
        RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l", "-", "\[Tau]m"}], "]"}], 
       
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]u"}], " ", "du"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]l"}], " ", "dl"}], "]"}], " ", "Heq", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "dm"}], " ", "\[Tau]m"}], "]"}]}], "+", 
      RowBox[{"q", " ", "Aeq", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]u"}], " ", "du"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Tau]l"}], " ", "dl"}], "]"}], " ", 
       RowBox[{"nH", "[", 
        RowBox[{"t", "-", "\[Tau]m"}], "]"}], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "dm"}], " ", "\[Tau]m"}], "]"}]}], "-", 
      RowBox[{"da", " ", 
       RowBox[{"nA", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"nP", "'"}], "[", "t", "]"}], " ", "==", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"nL", "[", 
        RowBox[{"t", "-", "\[Tau]j"}], "]"}], "Peq", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "dl"}], " ", "\[Tau]j"}], "]"}]}], "+", 
      RowBox[{"a", " ", "Leq", " ", 
       RowBox[{"nP", "[", 
        RowBox[{"t", "-", "\[Tau]j"}], "]"}], " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "dl"}], " ", "\[Tau]j"}], "]"}]}], "-", 
      RowBox[{"dp", " ", 
       RowBox[{"nP", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"nH", "'"}], "[", "t", "]"}], " ", "==", 
     RowBox[{
      RowBox[{"-", " ", "Heq"}], " ", "a", 
