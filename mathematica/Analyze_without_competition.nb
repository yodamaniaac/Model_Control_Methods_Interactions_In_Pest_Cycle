Cell["\<\
There are three equilibria. The first is trivial, the second is impossible \
because P is always negative, and the third is what we will call non-trivial.\
\
\>", "Text",
 CellChangeTimes->{{3.9419746435520477`*^9, 3.941974690151002*^9}, 
   3.9419748583789062`*^9, 
   3.985063473367399*^9},ExpressionUUID->"0ad0db69-ae7a-490d-9eb3-\
