 CellLabel->"In[28]:=",ExpressionUUID->"91cba1ce-c499-4939-8ed4-846abdc99954"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "D\[EAcute]finir", " ", "les", " ", "fonctions", " ", "par", " ", 
    "morceaux"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Lpiecewise", "[", "t_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"t", "<", "0"}]}], "}"}], "}"}], ",", 
      RowBox[{"L", "[", "t", "]"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"Apiecewise", "[", "t_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"t", "<", "0"}]}], "}"}], "}"}], ",", 
      RowBox[{"A", "[", "t", "]"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"Ppiecewise", "[", "t_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"t", "<", "0"}]}], "}"}], "}"}], ",", 
      RowBox[{"P", "[", "t", "]"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"Hpiecewise", "[", "t_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Tau]lN"}], "*", "\[CapitalDelta]lN"}], ",", 
         RowBox[{"t", "<", "0"}]}], "}"}], "}"}], ",", 
      RowBox[{"H", "[", "t", "]"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "R\[EAcute]soudre", " ", "les", " ", "\[EAcute]quations", " ", 
     "diff\[EAcute]rentielles"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solN", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ModeleReduit", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
            RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
            RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
            RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
            RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
            RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
            RowBox[{"q", "->", "qN"}], ",", 
            RowBox[{"\[Delta]a", "->", "\[Delta]aN"}], ",", 
            RowBox[{"\[Delta]j", "->", "\[Delta]jN"}], ",", 
            RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
            RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
            RowBox[{"a", "->", "aN"}], ",", 
            RowBox[{
             RowBox[{"L", "[", "t", "]"}], "->", 
             RowBox[{"Lpiecewise", "[", "t", "]"}]}], ",", 
            RowBox[{
             RowBox[{"A", "[", "t", "]"}], "->", 
             RowBox[{"Apiecewise", "[", "t", "]"}]}], ",", 
            RowBox[{
             RowBox[{"P", "[", "t", "]"}], "->", 
             RowBox[{"Ppiecewise", "[", "t", "]"}]}], ",", 
            RowBox[{
             RowBox[{"H", "[", "t", "]"}], "->", 
             RowBox[{"Hpiecewise", "[", "t", "]"}]}]}], "}"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Conditions", " ", "initiales", " ", "\[AGrave]", " ", "t"}], "=", 
           "0"}], "*)"}], 
         RowBox[{
          RowBox[{"L", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"A", "[", "0", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{"P", "[", "0", "]"}], "==", "0.1"}], ",", 
         RowBox[{
          RowBox[{"H", "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"-", "\[Tau]lN"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"aN", "*", "0.1"}], "+", "\[Delta]lN"}], ")"}]}]}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"L", ",", "A", ",", "P", ",", "H"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
          RowBox[{"\"\<DifferenceOrder\>\"", "->", "4"}]}], "}"}]}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
       RowBox[{"AccuracyGoal", "->", "10"}], ",", 
       RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Tracer", " ", "les", " ", "solutions"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Lpiecewise", "[", "t", "]"}], ",", 
         RowBox[{"Apiecewise", "[", "t", "]"}], ",", 
         RowBox[{"Ppiecewise", "[", "t", "]"}]}], "}"}], "/.", " ", "solN"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<L\>\"", ",", "\"\<A\>\"", ",", "\"\<P\>\""}], "}"}]}], 
     ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "\"\<Temps en semaines \>\"", "}"}], ",", 
        RowBox[{"{", "\"\<Nb Individus\>\"", "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9543144784132757`*^9, 3.954314497867312*^9}, {
  3.954314530237493*^9, 3.9543145309404*^9}},
 CellLabel->"",ExpressionUUID->"fbd41aa8-04a6-4ad9-913d-a3195151320d"],

