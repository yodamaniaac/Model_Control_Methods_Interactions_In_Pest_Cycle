Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleQuentin", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "70"}], ",", 
          RowBox[{"\[Delta]a", "->", "1"}], ",", 
          RowBox[{"\[Delta]j", "->", "\[Delta]jN"}], ",", 
          RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
          RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"P", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"Hp", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"U", ",", "A", ",", "P", ",", "Hp"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
        RowBox[{"\"\<DifferenceOrder\>\"", "->", "4"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
     RowBox[{"AccuracyGoal", "->", "10"}], ",", 
     RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"U", "[", "t", "]"}], ",", 
       RowBox[{"A", "[", "t", "]"}], ",", 
       RowBox[{"P", "[", "t", "]"}], ",", 
       RowBox[{"Hp", "[", "t", "]"}]}], "}"}], "/.", " ", "solN"}], "]"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<U\>\"", ",", "\"\<A\>\"", ",", "\"\<P\>\"", ",", "\"\<Hp\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<Temps en semaines \>\"", "}"}], ",", 
      RowBox[{"{", "\"\<Nb Individus\>\"", "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
