Cell["Comparaison de dynamique avec Julia ", "Section",
 CellChangeTimes->{
  3.938171386601739*^9},ExpressionUUID->"1d44292b-7c7f-425e-9136-\
6aacff952635"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleReduit", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "qN"}], ",", 
          RowBox[{"\[Delta]a", "->", "\[Delta]aN"}], ",", 
          RowBox[{"\[Alpha]l", "->", "\[Alpha]lN"}], ",", 
          RowBox[{"\[Delta]j", "->", "\[Delta]jN"}], ",", 
          RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
          RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"L", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"P", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", " ", 
       RowBox[{
        RowBox[{"Hc", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"Hp", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"U", ",", "L", ",", "A", ",", "P", ",", "Hc", ",", "Hp"}], 
