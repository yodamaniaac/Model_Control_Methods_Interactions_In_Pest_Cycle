Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleReduit", "/.", 
        RowBox[{"{", 
