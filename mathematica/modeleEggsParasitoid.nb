Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleQuentin", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", " ", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "0.02"}], ",", 
          RowBox[{"\[Delta]a", "->", "0.06"}], ",", 
          RowBox[{"\[Delta]j", "->", "\[Delta]jN"}], ",", 
          RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
          RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"t", "/;", 
