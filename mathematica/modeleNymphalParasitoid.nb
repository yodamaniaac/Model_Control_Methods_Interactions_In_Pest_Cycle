02811a2fc536"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleComplet", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "0.35"}], ",", 
          RowBox[{"\[Delta]a", "->", "1"}], ",", 
          RowBox[{"\[Alpha]l", "->", "\[Alpha]lN"}], ",", 
          RowBox[{"\[Delta]j", "->", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
          RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"L", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"J", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"P", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "0.1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Hp", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], "==", "HpIni"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]m", " ", "->", "\[Delta]mN"}], ",", 
          RowBox[{"\[Tau]m", " ", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "U", ",", "L", ",", " ", "M", ",", "A", ",", "J", ",", "P", ",", "Hp"}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
        RowBox[{"\"\<DifferenceOrder\>\"", "->", "4"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
     RowBox[{"AccuracyGoal", "->", "10"}], ",", 
     RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"U", "[", "t", "]"}], ",", 
