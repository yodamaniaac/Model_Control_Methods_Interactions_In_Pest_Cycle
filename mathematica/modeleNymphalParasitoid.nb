Cell[BoxData[{
 RowBox[{
  RowBox[{"solN", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ModeleComplet", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]u", " ", "->", "\[Delta]uN"}], ",", 
          RowBox[{"\[Delta]l", " ", "->", " ", "\[Delta]lN"}], ",", " ", 
          RowBox[{"\[Delta]m", " ", "->", " ", "0.49"}], ",", 
          RowBox[{"\[Tau]u", " ", "->", " ", "\[Tau]uN"}], ",", " ", 
          RowBox[{"\[Tau]l", " ", "->", " ", "\[Tau]lN"}], ",", " ", 
          RowBox[{"\[Tau]m", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"q", "->", "qN"}], ",", 
          RowBox[{"\[Delta]a", "->", "\[Delta]aN"}], ",", 
          RowBox[{"\[Alpha]l", "->", "\[Alpha]lN"}], ",", 
          RowBox[{"\[Delta]j", "->", "0.49"}], ",", 
          RowBox[{"\[Tau]j", "->", "\[Tau]jN"}], ",", 
          RowBox[{"\[Delta]p", "->", "\[Delta]pN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"U", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"L", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"J", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"P", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Hp", "[", 
          RowBox[{"t", "/;", 
           RowBox[{"t", "<=", "0"}]}], "]"}], "==", "HpIni"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]m", " ", "->", "0.49"}], ",", 
          RowBox[{"\[Tau]m", " ", "->", " ", "\[Tau]mN"}], ",", 
          RowBox[{"a", "->", "aN"}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "U", ",", "L", ",", " ", "M", ",", "A", ",", "J", ",", "P", ",", "Hp"}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
        RowBox[{"\"\<DifferenceOrder\>\"", "->", "4"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
     RowBox[{"AccuracyGoal", "->", "10"}], ",", 
     RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
