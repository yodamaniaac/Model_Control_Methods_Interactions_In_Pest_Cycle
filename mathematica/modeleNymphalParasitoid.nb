        RowBox[{"U", "[", "t", "]"}]}], "*)"}], "Red", ",", 
      RowBox[{"(*", 
       RowBox[{"Couleur", " ", "de", " ", 
        RowBox[{"L", "[", "t", "]"}]}], "*)"}], ",", 
      RowBox[{"Orange", 
       RowBox[{"(*", 
