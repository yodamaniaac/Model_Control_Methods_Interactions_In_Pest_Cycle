  3.9850547600702267`*^9}},ExpressionUUID->"ce0061e6-984c-4aca-a05d-\
1f49a2959fd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ModelWithoutParasitoid", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"U", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"q", "  ", 
        RowBox[{"A", "[", "t", "]"}]}], " ", "-", " ", 
       RowBox[{"q", " ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}]}], "  ", "-", " ", 
       RowBox[{"du", " ", 
        RowBox[{"U", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"L", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"q", "  ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}]}], "-", " ", 
       RowBox[{"q", " ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}], " ", 
        RowBox[{"H", "[", "t", "]"}]}], " ", "-", "  ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dl", "+", 
          RowBox[{"c", " ", 
           RowBox[{"L", "[", "t", "]"}]}]}], ")"}], " ", 
        RowBox[{"L", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"q", "  ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}], 
        RowBox[{"H", "[", "t", "]"}]}], " ", "-", "  ", 
       RowBox[{"q", "  ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l", "-", "\[Tau]m"}], "]"}],
         " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}], " ", 
        RowBox[{"H", "[", 
         RowBox[{"t", "-", " ", "\[Tau]m"}], "]"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "dm"}], " ", "\[Tau]m"}], "]"}]}], " ", "-", "  ", 
       RowBox[{"dm", " ", 
        RowBox[{"M", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"q", "  ", 
        RowBox[{"A", "[", 
         RowBox[{"t", "-", "\[Tau]u", "-", "\[Tau]l", "-", "\[Tau]m"}], "]"}],
         " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "du"}], " ", "\[Tau]u"}], "]"}], " ", 
        RowBox[{"H", "[", 
         RowBox[{"t", "-", " ", "\[Tau]m"}], "]"}], 
        RowBox[{"Exp", "[", 
